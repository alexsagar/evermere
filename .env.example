# Copy to .env.local. Never commit real values.

# Explicit mode: demo works offline; sanity fails clearly if configuration/content is missing.
CONTENT_SOURCE=sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=8nawnqp2
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
# SANITY_API_READ_TOKEN=            # server-only Viewer; required for the existing dotted migration IDs
# SANITY_REVALIDATE_SECRET=         # server-only random secret, at least 32 characters
# SANITY_AUTH_TOKEN=               # temporary CLI migration credential, never normal website access

# Inquiry: demo (default) validates and discards. Live stays disabled until every value below
# is approved and a distributed rate limiter exists; anything missing disables the endpoint.
# INQUIRY_MODE=demo
# RESEND_API_KEY=                   # server-only
# INQUIRY_SENDER_DOMAIN=            # verified sending domain
# INQUIRY_FROM_EMAIL=               # address on the sending domain
# INQUIRY_TO_EMAIL=                 # client-approved recipient
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=             # server-only
# INQUIRY_RATE_LIMIT=distributed

# Public origin for canonical and social URLs (local demo default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
