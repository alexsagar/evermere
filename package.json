{
  "name": "evermere",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cms:dry-run": "node scripts/sanity-prepare.cjs --dry-run",
    "cms:export": "node scripts/sanity-prepare.cjs --export",
    "cms:audit": "node scripts/sanity-audit.cjs",
    "cms:revalidate": "node scripts/sanity-revalidate.cjs",
    "studio": "node scripts/sanity-studio.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typegen": "sanity schema extract --path sanity/schema.json --force && sanity typegen generate",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "9.8.2",
    "@sanity/client": "^8.17.0",
    "@sanity/image-url": "^2.2.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "next": "16.4.6",
    "next-sanity": "13.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.25.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.7.0",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.13.1"
}
